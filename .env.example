# Password for the PostgreSQL container in docker-compose.yml.
# Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=
# PostgreSQL connection URL (use the same password as above)
DATABASE_URL=postgresql+psycopg2://postgres:<POSTGRES_PASSWORD>@localhost:5432/discord_register
# Required: secret used to sign session cookies (at least 32 characters).
# Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Optional: bootstrap admin account created on startup if it does not exist (password: 12+ characters)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
